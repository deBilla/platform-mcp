# --- Multi-environment (recommended) ---
# JSON map of environment name -> settings. Every tool takes an optional
# `environment` argument selecting one of these; omitting it uses the default.
# Per-environment keys: project (required), impersonate, billing_export_table,
# aliases. A bare string value is shorthand for {"project": "..."}.
PLATFORM_MCP_ENVIRONMENTS={"staging":{"project":"my-app-staging","impersonate":"platform-mcp-ro@my-app-staging.iam.gserviceaccount.com"},"production":{"project":"my-app","impersonate":"platform-mcp-ro@my-app.iam.gserviceaccount.com","billing_export_table":"my-app.billing.gcp_billing_export_v1_XXXXXX"}}

# Environment used when a tool call omits `environment`. Defaults to "staging"
# if configured, otherwise the first entry above.
PLATFORM_MCP_DEFAULT_ENVIRONMENT=staging

# --- Single-environment mode (used only when PLATFORM_MCP_ENVIRONMENTS is unset) ---
# Target GCP project (falls back to your ADC default project if unset).
# GCP_PROJECT=my-app-staging

# --- Auth (pick one; ADC is used if none set) ---
# Path to a read-only service-account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/read-only-sa.json
# Or impersonate a read-only SA without a downloaded key. When
# PLATFORM_MCP_ENVIRONMENTS is set, this is the fallback for any environment
# that does not specify its own "impersonate":
# IMPERSONATE_SERVICE_ACCOUNT=platform-mcp-ro@my-app-staging.iam.gserviceaccount.com

# --- Cost analysis (optional) ---
# Fallback BigQuery billing export table for environments that don't set
# "billing_export_table" themselves:
# BILLING_EXPORT_TABLE=my-app-staging.billing.gcp_billing_export_v1_XXXXXX

# Default max rows for list-style tools (optional).
# PLATFORM_MCP_DEFAULT_LIMIT=50
